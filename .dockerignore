# VCS
# Keep .git in the context long enough for Dockerfile to bake the version.
# Dockerfile removes the repository metadata after creating the version file.
.git/config
.git/config.worktree
.git/hooks
.git/logs
.gitignore

# Local secrets/config
.env
.env.*
*.pem
*.key

# Python cache/artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Build/dev artifacts
*.log
*.tmp
*.swp

# Container metadata
Dockerfile
docker-compose.yml
compose.yaml
control-ui/

# Docs and license (not required at runtime)
README.md
LICENSE
