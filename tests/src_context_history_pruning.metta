!(import! &self ./tests/lib/utils)
!(import! &self ../src/helper.py)
!(import! &self ../plugins/context/frame_helpers.py)
!(import! &self ../src/utils)
!(import! &self ../plugins/context/contextframe)

; Keep this helper before assertions because PeTTa evaluates test expressions as it loads them.
(= (cfv2-event-kinds ()) ())
(= (cfv2-event-kinds (cons (FrameEvent (frameID $frameID) (category $category)
                          (kind $kind) (payload $payload) (timestamp $timestamp)) $tail))
    (cons $kind (cfv2-event-kinds $tail)))

(= (maxFrameHistoryEvents) 3)
!(change-state! &cfv2-current-frame-id FramePruneA)
!(change-state! &cfv2-current-history-summary "")
!(change-state! &cfv2-frame-event-space ())
!(change-state! &cfv2-frame-prune-space ())
!(change-state! &test-pruned-audit ())

; Capture the exact archive text without writing the test runner's real history.
(= (append-file-raw $path $entry)
    (change-state! &test-pruned-audit
       (append (get-state &test-pruned-audit) ($entry))))

!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type UserDirective)
   "Original frame directive")
!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type HypothesisAdded)
   "Key decision one")
!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type ResultAdded)
   "Important outcome")
!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type DeliverableAdded)
   "Recent event one")
!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type FrameCompleted)
   "Recent event two")
!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type FrameJunkCleared)
   "Recent event three")

!(test (== (cfv2-list-length (cfv2-get-frame-events FramePruneA ())) 3) True)
!(test (== (cfv2-event-kinds (cfv2-get-frame-events FramePruneA ()))
           (DeliverableAdded FrameCompleted FrameJunkCleared)) True)
!(test (contains-text (repr (get-state &test-pruned-audit)) "Original frame directive") True)
!(test (contains-text (repr (get-state &test-pruned-audit)) "Key decision one") True)
!(test (contains-text (repr (get-state &test-pruned-audit)) "Important outcome") True)
!(test (contains-text (get-state &cfv2-current-history-summary) "2026-") True)
!(test (contains-text (get-state &cfv2-current-history-summary) "PRUNED HISTORY") True)
!(test (contains-text (get-state &cfv2-current-history-summary) "episodes") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "3 events omitted") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "2026-") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      " through 2026-") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "Original directive: Original frame directive") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "HypothesisAdded: Key decision one") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "ResultAdded: Important outcome") True)
!(test (<= (string_length (cfv2-prune-summary
               (cfv2-get-frame-prune-record FramePruneA)))
           (cfv2PrunedHistorySummaryLimit)) True)
!(test (<= (string_length (get-state &cfv2-current-history-summary))
           (cfv2HistorySummaryLimit)) True)

; Two more events each prune one additional old event. The cumulative count and
; timestamp range in the notice must advance while its summary remains bounded.
!(change-state! &cfv2-current-frame-id FramePruneA)
!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type ConstraintAdded)
   "Repeated-prune decision")
!(cfv2-add-frame-event FramePruneA (cfv2-history-event-type ResultAdded)
   "Repeated-prune outcome")
!(test (== (cfv2-list-length (cfv2-get-frame-events FramePruneA ())) 3) True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "5 events omitted") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "2026-") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      " through 2026-") True)
!(test (contains-text (cfv2-prune-summary (cfv2-get-frame-prune-record FramePruneA))
                      "Original frame directive") True)
!(test (contains-text (repr (get-state &test-pruned-audit)) "Recent event one") True)
!(test (contains-text (repr (get-state &test-pruned-audit)) "Recent event two") True)
!(test (<= (string_length (cfv2-prune-summary
               (cfv2-get-frame-prune-record FramePruneA)))
           (cfv2PrunedHistorySummaryLimit)) True)

; Overflow in Frame B must leave Frame A's retained history untouched.
!(change-state! &cfv2-current-frame-id FramePruneB)
!(cfv2-add-frame-event FramePruneB (cfv2-history-event-type UserDirective) "Frame B directive")
!(cfv2-add-frame-event FramePruneB (cfv2-history-event-type ResultAdded) "Frame B result")
!(cfv2-add-frame-event FramePruneB (cfv2-history-event-type ConstraintAdded) "Frame B constraint")
!(cfv2-add-frame-event FramePruneB (cfv2-history-event-type DeliverableAdded) "Frame B deliverable")
!(test (== (cfv2-list-length (cfv2-get-frame-events FramePruneA ())) 3) True)
!(test (== (cfv2-list-length (cfv2-get-frame-events FramePruneB ())) 3) True)
!(test (contains-text (cfv2-prune-summary
               (cfv2-get-frame-prune-record FramePruneA))
                      "Original frame directive") True)
!(test (contains-text (cfv2-prune-summary
               (cfv2-get-frame-prune-record FramePruneB))
                      "Frame B directive") True)

