!(import! &self ./tests/res/router_setup)
!(import! &self ../src/utils.py)
!(import! &self ../src/providers.py)
!(import! &self ./src/providers)

(= (listOf $a) (py-call (utils.listAppend (py-call (utils.listNew)) $a)))
(= (listOf $a $b) (py-call (utils.listAppend (listOf $a) $b)))
(= (listOf $a $b $c) (py-call (utils.listAppend (listOf $a $b) $c)))
(= (userMsg $text) (llmRequestMessage role "user" content $text))
(= (toolMsg $text) (llmToolCallResponseMessage role "tool" callid "call#0" content $text))
(= (assistantMsg) (llmToolCallMessage role "assistant" calls (py-call (utils.listNew)) content "[TOOL CALL]"))
(= (systemRequest $system $episodes)
   (llmRequest (llmRequestMessage role "system" content $system) $episodes 100 medium ()))
(= (routeRequest $request)
   (default-LLM-ROUTER (py-call (providers.llmRequestContentsNormalized $request))))
(= (latched) (collapse (match &plugin-default (role $x) $x)))

!(test (default-LLM-ROUTER "segment_user alert_failed") premium)
!(test (default-LLM-ROUTER "segment_user alert failed") routine)
!(test (default-LLM-ROUTER "segment_user failed alert") routine)

!(test (default-LLM-ROUTER "segment_user hello segment_tool one segment_tool two segment_tool three segment_tool four segment_tool five segment_tool six segment_tool seven segment_tool eight segment_assistant a1 segment_assistant a2 segment_assistant a3 segment_assistant a4 segment_assistant a5") routine)
!(test (default-LLM-ROUTER "segment_user hello segment_assistant a1 segment_tool one segment_assistant a2 segment_tool two segment_assistant a3 segment_tool three segment_assistant a4 segment_tool four segment_assistant a5 segment_tool five segment_assistant a6 segment_tool six segment_assistant a7 segment_tool seven segment_assistant a8 segment_tool eight segment_assistant a9 segment_tool nine") premium)

!(test (default-LLM-ROUTER "segment_tool /premium segment_user hello") routine)
!(test (default-LLM-ROUTER "segment_user hello segment_tool /premium") routine)
!(test (default-LLM-ROUTER "segment_user hello") routine)
!(test (latched) ())

!(test (default-LLM-ROUTER "segment_user hello segment_assistant /premium") routine)
!(test (default-LLM-ROUTER "segment_assistant /premium segment_user hello") routine)
!(test (default-LLM-ROUTER "segment_user hello") routine)
!(test (latched) ())

!(test (default-LLM-ROUTER "segment_user /premium") premium)
!(test (default-LLM-ROUTER "segment_user hello /premium again") premium)
!(test (default-LLM-ROUTER "segment_user /premium") premium)
!(test (default-LLM-ROUTER "segment_user /routine") routine)
!(test (latched) ())
!(test (default-LLM-ROUTER "segment_user hello") routine)

!(test (default-LLM-ROUTER "segment_user please use /premium now") premium)
!(test (default-LLM-ROUTER "segment_user and also this") premium)
!(test (default-LLM-ROUTER "segment_user please use /routine now") routine)
!(test (default-LLM-ROUTER "segment_user and also this") routine)

!(test (routeRequest (systemRequest "You may type /premium or hit alert_failed" (listOf (userMsg "hello")))) routine)
!(test (routeRequest (systemRequest "/premium alert_failed" (listOf (userMsg "hello") (assistantMsg) (toolMsg "SUCCESS, RETURN: ok")))) routine)
!(test (latched) ())

!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "hello") (assistantMsg) (toolMsg "ALERT_FAILED(Error (python_error RuntimeError boom))")))) premium)
!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "hello") (assistantMsg) (toolMsg "SUCCESS, RETURN: all good")))) routine)

!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "Alert_Failed")))) premium)
!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "hello") (assistantMsg) (toolMsg "ALERT_FAILED(Error (x, y))")))) premium)
!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "/PREMIUM")))) premium)
!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "hello")))) premium)
!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "/ROUTINE")))) routine)
!(test (routeRequest (systemRequest "prompt" (listOf (userMsg "hello")))) routine)
!(test (latched) ())
