(= (provider) (empty))
!(import! &self ./lib/utils.py)
!(import! &self ../src/helper.py)
!(import! &self ../src/config.py)
!(import! &self ./src/utils)
!(import! &self ./src/config)

(= (cleanup)
   (progn
     (collapse (match &self (= (command-line) $b) (remove-atom &self (= (command-line) $b))))
     (collapse (match &self (= (provider) $b) (remove-atom &self (= (provider) $b))))
     (collapse (match &self (= (routerCatalogFile) $b) (remove-atom &self (= (routerCatalogFile) $b))))
     (collapse (match &self (routerCatalog $b) (remove-atom &self (routerCatalog $b))))))

(= (catalogs) (collapse (match &self (routerCatalog $entries) $entries)))
(= (roleNames)
   (collapse (let $entries (match &self (routerCatalog $e) $e)
                (let ($role $fields) (superpose $entries) $role))))
(= (fieldOf $role $key)
   (collapse (let $entries (match &self (routerCatalog $e) $e)
                (let ($r $fields) (superpose $entries)
                   (if (== $r $role)
                       (let ($k $v) (superpose $fields)
                          (if (== $k $key) $v (empty)))
                       (empty))))))
(= (routerCatalogFileValues) (collapse (match &self (= (routerCatalogFile) $name) $name)))

(= (command-line)
   ("config=./tests/res/src_config_empty.yaml"
    "routerCatalogFile=./tests/res/router_catalog_two_roles.json"))
!(initConfig)
!(configure routerCatalogFile none)
!(test (size-atom (catalogs)) 1)
!(test (roleNames) (routine premium))
!(test (fieldOf routine model) ("routine-model"))
!(test (fieldOf routine provider) ("OpenAIAPI"))
!(test (fieldOf routine openaiapi_url) ("http://routine.invalid/v1/"))
!(test (fieldOf premium model) ("premium-model"))
!(test (fieldOf premium provider) ("Anthropic"))
!(test (fieldOf premium api_token_var) ("ANTHROPIC_API_KEY"))
!(test (routerCatalogFileValues) (./tests/res/router_catalog_two_roles.json))
!(cleanup)

(= (command-line)
   ("config=./tests/res/router_config_catalog.yaml"))
!(initConfig)
!(configure routerCatalogFile none)
!(test (size-atom (catalogs)) 1)
!(test (roleNames) (routine premium))
!(test (fieldOf routine model) ("routine-model"))
!(test (fieldOf premium model) ("premium-model"))
!(test (routerCatalogFileValues) (./tests/res/router_catalog_two_roles.json))
!(cleanup)

(= (command-line)
   ("config=./tests/res/router_config_models.yaml"
    "provider=Anthropic"
    "model=model-from-command-line"
    "openaiapi_url=http://single.invalid/v1/"))
!(initConfig)
!(configure provider none)
!(configure routerCatalogFile none)
!(test (size-atom (catalogs)) 1)
!(test (roleNames) (routine))
!(test (fieldOf routine provider) (Anthropic))
!(test (fieldOf routine model) (model-from-command-line))
!(test (fieldOf routine api_token_var) (ANTHROPIC_API_KEY))
!(test (fieldOf routine openaiapi_url) (http://single.invalid/v1/))
!(test (routerCatalogFileValues) ())
!(cleanup)

(= (command-line)
   ("config=./tests/res/router_config_models.yaml"
    "provider=Anthropic"))
!(initConfig)
!(configure provider none)
!(configure routerCatalogFile none)
!(test (roleNames) (routine))
!(test (fieldOf routine model) (anthropic-model-from-yaml))
!(test (fieldOf routine openaiapi_url) (http://localhost:11434/v1/))
!(cleanup)
