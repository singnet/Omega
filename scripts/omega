#!/usr/bin/env bash

bootstrap() {

# Create temporary files
tmp_config_file="$(mktemp)"
tmp_py_file="$(mktemp)"
trap 'rm -f "$tmp_config_file" "$tmp_py_file"' EXIT

# Lock down permissions immediately after creation
chmod 0600 "$tmp_config_file"
chmod 0600 "$tmp_py_file"

cat >"$tmp_py_file" <<'PY'
import getpass
import json
import os
import secrets
import string
import shlex
import shutil
import sys
import textwrap
import urllib.error
import urllib.parse
import urllib.request

