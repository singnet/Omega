def print_wrapped(text: str) -> None:
    width = max(60, min(shutil.get_terminal_size((100, 24)).columns - 2, 100))
    for paragraph in text.strip().split("\n\n"):
        print(textwrap.fill(paragraph, width=width))
        print()


def require_license_acceptance():
    print_wrapped(LICENSE_TEXT)
    print()
    while True:
        reply = input("I HAVE READ AND UNDERSTOOD THE DISCLAIMER. Type 'accept' to continue or 'q' to exit: ").strip().lower()
        if reply == "accept":
            return
        if reply == "q":
            sys.exit(1)
        print("You must type 'accept' or 'q'.", file=sys.stderr)


def _telegram_api_call(bot_token, method, params=None, timeout=20):
    params = params or {}
    url = f"https://api.telegram.org/bot{bot_token}/{method}"
    if params:
        url = f"{url}?{urllib.parse.urlencode(params)}"

    req = urllib.request.Request(url)
    with urllib.request.urlopen(req, timeout=timeout) as response:
        payload = json.loads(response.read().decode("utf-8", errors="ignore"))

    if not payload.get("ok"):
        raise RuntimeError(payload.get("description", f"{method} failed"))

    return payload.get("result")


def _slack_api_call(bot_token, method, params=None, timeout=20):
    params = params or {}
    body = urllib.parse.urlencode(params).encode("utf-8")
    req = urllib.request.Request(
        f"https://slack.com/api/{method}",
        data=body,
        headers={
            "Authorization": f"Bearer {bot_token}",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )

    with urllib.request.urlopen(req, timeout=timeout) as response:
        payload = json.loads(response.read().decode("utf-8", errors="ignore"))

    if not payload.get("ok"):
        raise RuntimeError(payload.get("error", f"{method} failed"))

    return payload


def _choose_channel():
    while True:
        print("Please select your communication channel.")
        print("1) IRC (QuakeNet) 2) Telegram Bot 3) Slack Bot 4) WebSocket Chat")
        c = input("Enter 1-4 or 'q' to exit (default: 1): ").strip()

        if c.lower() == "q":
            sys.exit(1)

        if c in ("", "1"):
            while True:
                print("Please enter your unique IRC channel. Example: ##MyOmega54323")
                channel = input("Enter IRC channel or 'q' to exit: ").strip()
                if channel.lower() == "q":
                    sys.exit(1)
                if not channel:
                    print("IRC channel is required.", file=sys.stderr)
                    continue
                return {
                    "commchannel": "irc",
                    "IRC_channel": channel,
                }

        if c == "2":
            while True:
                token = getpass.getpass("Please paste your Telegram bot token and press ENTER or 'q' to exit: ").strip()

                if token.lower() == "q":
                    sys.exit(1)

                if not token:
                    print("Telegram bot token is required.", file=sys.stderr)
                    continue

                try:
                    me = _telegram_api_call(token, "getMe", timeout=15)
                    username = str(me.get("username", "")).strip()
                except (RuntimeError, urllib.error.URLError, TimeoutError) as exc:
                    print(f"Telegram token validation failed: {exc}", file=sys.stderr)
                    continue

                print("Telegram bot token validated.")
                if username:
                    print(f"Talk to your bot here: https://t.me/{username}")
                print("No Telegram chat ID is needed. Omega will auto-bind after your first auth message.")

                return {
                    "commchannel": "telegram",
                    "TG_BOT_TOKEN": token,
                    "TG_CHAT_ID": "",
                    "TG_POLL_TIMEOUT": "20",
                    "TG_BOT_USERNAME": username,
                }

        if c == "3":
            while True:
                token = getpass.getpass("Please paste your Slack bot token (xoxb-...) and press ENTER or 'q' to exit: ").strip()
                if token.lower() == "q":
                    sys.exit(1)
                if not token:
                    print("Slack bot token is required.", file=sys.stderr)
                    continue

                channel_id = input("Optional Slack channel ID (example: C0123456789). Leave empty for auto-bind, or 'q' to exit: ").strip()
                if channel_id.lower() == "q":
                    sys.exit(1)

                try:
                    auth = _slack_api_call(token, "auth.test", timeout=15)
                    team_name = str(auth.get("team", "")).strip()
                    channel_name = ""
                    if channel_id:
                        conv = _slack_api_call(token, "conversations.info", {"channel": channel_id}, timeout=15)
                        channel = conv.get("channel") or {}
                        channel_name = str(channel.get("name", "")).strip()
                except (RuntimeError, urllib.error.URLError, TimeoutError) as exc:
                    print(f"Slack validation failed: {exc}", file=sys.stderr)
                    continue

                print("Slack token validated.")
                if team_name:
                    print(f"Slack workspace: {team_name}")
                if channel_name:
                    print(f"Slack channel: #{channel_name} ({channel_id})")
                    print("Invite the bot user to that channel before sending messages.")
                elif channel_id:
                    print(f"Slack channel ID: {channel_id}")
                    print("Invite the bot user to that channel before sending messages.")
                else:
                    print("No channel ID set. Omega will auto-bind to the first channel where auth succeeds.")

                return {
                    "commchannel": "slack",
                    "SL_BOT_TOKEN": token,
                    "SL_CHANNEL_ID": channel_id,
                    "SL_POLL_INTERVAL": "2",
                    "SL_TEAM_NAME": team_name,
                    "SL_CHANNEL_NAME": channel_name,
                }

        if c == "4":
            while True:
                print("Please enter your WebSocket chat server URL. Example: wss://chat.example.com/agent")
                url = input("Enter WebSocket URL or 'q' to exit: ").strip()
                if url.lower() == "q":
                    sys.exit(1)
                if not url:
                    print("WebSocket URL is required.", file=sys.stderr)
                    continue
                if not (url.startswith("ws://") or url.startswith("wss://")):
                    print("WebSocket URL must start with ws:// or wss://.", file=sys.stderr)
                    continue

                token = getpass.getpass("Optional bearer token (press ENTER to skip) or 'q' to exit: ").strip()
                if token.lower() == "q":
                    sys.exit(1)

                return {
                    "commchannel": "websocket",
                    "WS_URL": url,
                    "WS_TOKEN": token,
                }

        print("Please enter 1, 2, 3, 4, or 'q'.", file=sys.stderr)


def _choose_provider():
    while True:
        print("Please select your LLM provider.")
        print("1) Anthropic/Claude 2) OpenAI/ChatGPT 3) ASI Cloud Minimax 4) ASI:One")
        print("5) OpenRouter/GLM 6) OpenAI API endpoint")
        c = input("Enter 1-6 or 'q' to exit (default: 1): ").strip()

        if c.lower() == "q":
            sys.exit(1)

        if not c:
            provider_id = 0
        elif int(c) in range(1, 7):
            provider_id = int(c) - 1
        else:
            print("Please enter 1-6 or 'q'", file=sys.stderr)
            continue

        providers = [
            ("Anthropic", "Local", "ANTHROPIC_API_KEY"),
            ("OpenAI", "OpenAI", "OPENAI_API_KEY"),
            ("ASICloud", "Local", "ASI_API_KEY"),
            ("ASIOne", "Local", "ASIONE_API_KEY"),
            ("OpenRouter", "Local", "OPENROUTER_API_KEY"),
            ("OpenAIAPI", "Local", "OPENAIAPI_API_KEY"),
        ]
        provider, embeddingprovider, api_token_var = providers[provider_id]

        token = _prompt_llm_token()

        model = ""
        c = input(f"Enter LLM model (default depends on provider): ").strip()
        if c != "":
            model = c

        openaiapi_url = ""
        if provider == "OpenAIAPI":

            openaiapi_url = "http://localhost:11434/v1"
            c = input(f"Enter LLM API URL (default: {openaiapi_url}): ").strip()
            if c != "":
                openaiapi_url = c
            print(f"LLM API URL is set to {openaiapi_url}")

        return provider, embeddingprovider, api_token_var, model, openaiapi_url, token


def _choose_import_kb():
    while True:
        c = input(
            "Import knowledge base on startup? Will improve results but takes about 30 minutes. [y/N]: "
        ).strip().lower()

        if c in ("y", "yes"):
            return "1"

        if c in ("", "n", "no"):
            return "0"

        if c == "q":
            sys.exit(1)

        print("Please enter y or n.")


def _choose_memory_transfer():
    while True:
        answer = input("Set up a directory for memory transfer archives? [y/N]: ").strip().lower()
        if answer in ("", "n", "no"):
            return "", "0"
        if answer == "q":
            sys.exit(1)
        if answer not in ("y", "yes"):
            print("Please enter y or n.")
            continue

        value = input("Host directory for memory archives: ").strip()
        if not value:
            print("A directory is required.", file=sys.stderr)
            continue
        path = os.path.abspath(os.path.expanduser(value))
        try:
            os.makedirs(path, exist_ok=True)
        except OSError as exc:
            print(f"Could not create {path}: {exc}", file=sys.stderr)
            continue
        if not os.access(path, os.W_OK):
            print(f"Directory is not writable: {path}", file=sys.stderr)
            continue

        while True:
            enable = input("Enable memory export for this instance? [y/N]: ").strip().lower()
            if enable in ("", "n", "no"):
                return path, "0"
            if enable in ("y", "yes"):
                return path, "1"
            if enable == "q":
                sys.exit(1)
            print("Please enter y or n.")


def _prompt_llm_token():
    while True:
        token = getpass.getpass("Please paste your LLM token and press ENTER or 'q' to exit: ").strip()

        if token.lower() == "q":
            sys.exit(1)

        if not token:
            print("Error: Invalid token", file=sys.stderr)
            continue

        return token


def _write_kv(fp, key, value):
    fp.write(f"{key}={shlex.quote(str(value))}\n")


def config_run_omega(
    config_output_path,
    configured_memory_transfer_dir="",
    configured_memory_export_enabled="0",
):
    print(" ")
    print("Welcome to Omega!")
    print(" ")
    require_license_acceptance()

    channel_config = _choose_channel()
    provider, embeddingprovider, api_token_var, model, openaiapi_url, token = _choose_provider()
    import_kb_on_start = _choose_import_kb()
    if configured_memory_transfer_dir:
        memory_transfer_dir = configured_memory_transfer_dir
        memory_export_enabled = configured_memory_export_enabled
        print(f"Using memory transfer directory: {memory_transfer_dir}")
    else:
        memory_transfer_dir, memory_export_enabled = _choose_memory_transfer()

    with open(config_output_path, "w", encoding="utf-8") as f:
        _write_kv(f, "api_token_var", api_token_var)
        _write_kv(f, "api_token", token)
        _write_kv(f, "OMEGA_AUTH_SECRET", "".join(secrets.choice(string.digits) for _ in range(6)))
        _write_kv(f, "provider", provider)
        _write_kv(f, "embeddingprovider", embeddingprovider)
        _write_kv(f, "model", model)
        _write_kv(f, "openaiapi_url", openaiapi_url)
        _write_kv(f, "IMPORT_KB_ON_START", import_kb_on_start)
        _write_kv(f, "memory_transfer_dir", memory_transfer_dir)
        _write_kv(f, "memory_export_enabled", memory_export_enabled)
        for key, value in channel_config.items():
            _write_kv(f, key, value)


if __name__ == "__main__":
    config_run_omega(*sys.argv[1:4])
PY

python3 "$tmp_py_file" "$tmp_config_file" \
    "${memory_transfer_dir:-}" "${memory_export_enabled:-0}" </dev/tty

. "$tmp_config_file"

cat <<EOF

============================================
 HOW TO START AND STOP OMEGA
============================================

Stop Omega:
  docker stop omega

Restart Omega:
  docker start omega

To switch to a different channel or token:
  Rerun this script

Examine log file in case of problem:
  docker logs -f omega

EOF

if [ "${commchannel}" = "websocket" ]; then
cat <<EOF

============================================
 WEBSOCKET CHAT ENABLED
============================================

This instance is configured to connect to a WebSocket chat server.
Interact with the agent through the connected frontend.

WebSocket URL:
  ${WS_URL:-<not set>}

EOF
elif [ "${commchannel}" = "irc" ]; then
cat <<EOF

Auth secret (required once on first message in supported channels):
  $OMEGA_AUTH_SECRET

EOF
cat <<EOF

============================================
 HOW TO INTERACT WITH OMEGA IRC
============================================

Please go to https://webchat.quakenet.org/ or any IRC client.
Then, enter a unique username and this channel:
  $IRC_channel

Authentication step (required):
  Once in the $IRC_channel channel, send this one-time secret exactly once:
  auth ${OMEGA_AUTH_SECRET}
  The first nickname that sends it becomes the only accepted user.
  Messages from all other users will be silently ignored.

EOF
elif [ "${commchannel}" = "telegram" ]; then
cat <<EOF

Auth secret (required once on first message in supported channels):
  $OMEGA_AUTH_SECRET

EOF
cat <<EOF

============================================
 HOW TO INTERACT WITH OMEGA TELEGRAM
============================================

Open Telegram and send this auth message to your bot:
  auth $OMEGA_AUTH_SECRET

EOF

if [ -n "${TG_BOT_USERNAME:-}" ]; then
cat <<EOF
Bot link:
  https://t.me/$TG_BOT_USERNAME

EOF
fi

cat <<EOF
No chat ID is required. Omega binds to your chat automatically after successful auth.

EOF
elif [ "${commchannel}" = "slack" ]; then
cat <<EOF

============================================
 HOW TO INTERACT WITH OMEGA SLACK
============================================

EOF

if [ -n "${SL_CHANNEL_ID:-}" ]; then
cat <<EOF
Invite your Slack bot user to channel:
  ${SL_CHANNEL_NAME:-$SL_CHANNEL_ID}

Then send this auth message in that channel:
  auth $OMEGA_AUTH_SECRET

EOF
else
cat <<EOF
Invite your Slack bot user to at least one channel, then send:
  auth $OMEGA_AUTH_SECRET

The first channel where auth succeeds will be bound automatically.

EOF
fi

if [ -n "${SL_TEAM_NAME:-}" ]; then
cat <<EOF
Slack workspace:
  $SL_TEAM_NAME

EOF
fi
fi

start

}

_trim() {
    local value="${1-}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

bare_omega_version() {
    local script_dir
    local repo_root

    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    repo_root="$(cd -- "${script_dir}/.." && pwd)"
    (
        cd -- "$repo_root"
        python3 -c 'from src.helper import omega_version; print(omega_version())'
    )
}

version() {
    local bare
    bare="$(_trim "$(bare_omega_version 2>/dev/null || true)")"
    if [ -z "$bare" ]; then
        printf '%s\n' "Omega unknown"
    else
        printf 'Omega version=%s\n' "$bare"
    fi
}

strip_dirty_suffix() {
    local version="$1"
    if [[ "$version" == *-dirty ]]; then
        version="${version%-dirty}"
    fi
    printf '%s' "$version"
}

read_image_omega_version() {
    local raw=""
    raw="$(docker run --rm --entrypoint cat "${image}" /PeTTa/repos/Omega/version 2>/dev/null || true)"
    raw="$(_trim "$raw")"
    if [ -z "$raw" ]; then
        raw="$(docker run --rm --workdir /PeTTa/repos/Omega --entrypoint python3 "${image}" \
            -c 'from src.helper import omega_version; print(omega_version())' 2>/dev/null || true)"
        raw="$(_trim "$raw")"
    fi
    printf '%s' "$raw"
}

ensure_launcher_matches_image() {
    local script_version image_version
    script_version="$(strip_dirty_suffix "$(_trim "$(bare_omega_version 2>/dev/null || true)")")"
    if [ -z "$script_version" ]; then
        echo "Could not determine the launcher script version; skipping version check." >&2
        echo "Use the same tag for scripts/omega and the Docker image." >&2
        return 0
    fi

    image_version="$(strip_dirty_suffix "$(read_image_omega_version)")"
    if [ -z "$image_version" ]; then
        echo "Could not determine the Docker image version; skipping version check." >&2
        echo "Use the same tag for scripts/omega and the Docker image." >&2
        return 0
    fi

    if [[ "$script_version" != "$image_version" ]]; then
        cat >&2 <<EOF
The launcher script and Docker image versions do not match.
  Script: Omega version=${script_version}
  Image (${image}): Omega version=${image_version}

Update the script or the image so both are the same tag/commit. For example:
  curl -fsSL https://github.com/singnet/Omega/raw/refs/tags/<tag>/scripts/omega | bash -s -- singularitynet/omega:<tag>
EOF
        return 1
    fi
}

help() {
    echo -e "Usage: ${0} [<image tag> | command [options]]"
    echo
    echo -e "If used with <image tag> instead of command then boostrap Docker container"
    echo -e "in interactive mode."
    echo
    echo -e "Commands:"
    echo -e "\tstart start new docker container"
    echo -e "\tstop stop docker container"
    echo -e "\tclean remove container and clean up memory"
    echo
    echo -e "Options:"
    echo -e "\t-s <auth secret> set secret for the communication channel (default is 0000)"
    echo -e "\t-p <provider> set LLM API provider (default is ASICloud)."
    echo -e "\t              Pass API token via environment variable."
    echo -e "\t-m <model> set LLM model to use with provider (default depends on provider)."
    echo -e "\t-u <LLM API url> set LLM API URL for the OpenAIAPI provider"
    echo -e "\t-g <OpenClaw Gateway url> enable the openclaw plugin against this Gateway"
    echo -e "\t              Pass the Gateway token via OMEGA_OPENCLAW_TOKEN"
    echo -e "\t-c <IRC channel> set IRC channel"
    echo -e "\t-t <channel type> set communication channel type: irc|telegram|slack|websocket|mattermost|test"
    echo -e "\t-d <Docker image> set Docker image name (default omega:latest)"
    echo -e "\t-l <logging config> set Python logging config file"
    echo -e "\t--version, -v show the Omega version"
    echo -e "\t--help, -h show this help"
    echo
    echo -e "Memory portability options:"
    echo -e "\t--memory-transfer-dir <absolute-path> mount host directory for memory export/import archives"
    echo -e "\t--enable-memory-export enable memory export"
    echo -e "\t--memory-import <filename> restore archive from transfer directory before startup"
    echo -e "\t--memory-mode overwrite|append import mode (default: overwrite)"
    echo -e "\t--only-history restore history only"
    echo -e "\t--only-vector restore long-term memory only"
}

require_option_value() {
    if [[ "$#" -lt 2 || -z "${2}" ]]; then
        echo "${1} requires a value" >&2
        return 1
    fi
}

options() {
    OMEGA_AUTH_SECRET=0000
    provider=ASICloud
    image=singularitynet/omega:latest
    commchannel=irc
    IRC_channel="${IRC_channel:-##omega}"
    TG_BOT_TOKEN="${TG_BOT_TOKEN:-}"
    TG_POLL_TIMEOUT="${TG_POLL_TIMEOUT:-20}"
    SL_BOT_TOKEN="${SL_BOT_TOKEN:-}"
    SL_CHANNEL_ID="${SL_CHANNEL_ID:-}"
    SL_POLL_INTERVAL="${SL_POLL_INTERVAL:-2}"
    WS_URL="${WS_URL:-}"
    WS_TOKEN="${WS_TOKEN:-}"
    OMEGA_OPENCLAW_TOKEN="${OMEGA_OPENCLAW_TOKEN:-}"
    commchannel=irc
    log_config_path=""
    memory_transfer_dir=""
    memory_import_file=""
    memory_import_mode="overwrite"
    memory_import_only_history=0
    memory_import_only_vector=0
    memory_export_enabled=0

    if [[ "$#" -eq 0 ]]; then
        help
        return 1
    fi

    command=${1}
    shift 1

    while [[ "$#" -gt 0 ]]; do
        case "${1}" in
            -s?*) OMEGA_AUTH_SECRET=${1:2}; shift; continue;;
            -t?*) commchannel=${1:2}; shift; continue;;
            -p?*) provider=${1:2}; shift; continue;;
            -u?*) openaiapi_url=${1:2}; shift; continue;;
            -g?*) openclaw_url=${1:2}; shift; continue;;
            -c?*) IRC_channel=${1:2}; shift; continue;;
            -d?*) image=${1:2}; shift; continue;;
            -l?*) log_config_path=${1:2}; shift; continue;;
            -m?*) model=${1:2}; shift; continue;;
            -s|-t|-p|-u|-g|-c|-d|-l|-m|--memory-transfer-dir|--memory-import|--memory-mode)
                require_option_value "${1}" "${2:-}" || return 1
                ;;
        esac
        case "${1}" in
            -s) OMEGA_AUTH_SECRET=${2}; shift 2;;
            -t) commchannel=${2}; shift 2;;
            -p) provider=${2}; shift 2;;
            -u) openaiapi_url=${2}; shift 2;;
            -g) openclaw_url=${2}; shift 2;;
            -c) IRC_channel=${2}; shift 2;;
            -d) image=${2}; shift 2;;
            -l) log_config_path=${2}; shift 2;;
            -m) model=${2}; shift 2;;
            --memory-transfer-dir)
                memory_transfer_dir="${2}"
                shift 2
                ;;
            --enable-memory-export)
                memory_export_enabled=1
                shift
                ;;
            --memory-import)
                memory_import_file="${2}"
                shift 2
                ;;
            --memory-mode)
                memory_import_mode="${2}"
                shift 2
                ;;
            --only-history)
                memory_import_only_history=1
                shift
                ;;
            --only-vector)
                memory_import_only_vector=1
                shift
                ;;
            --version|-v) version; return 0;;
            --help|-h) help; return 0;;
            *) help
               return 1
               ;;
        esac
    done

    case "${provider}" in
        Anthropic)
            embeddingprovider="Local"
            api_token_var="ANTHROPIC_API_KEY"
            ;;
        ASICloud)
            embeddingprovider="Local"
            api_token_var="ASI_API_KEY"
            ;;
        OpenAI)
            embeddingprovider="OpenAI"
            api_token_var="OPENAI_API_KEY"
            ;;
        ASIOne)
            embeddingprovider="Local"
            api_token_var="ASIONE_API_KEY"
            ;;
        OpenAIAPI)
            embeddingprovider="Local"
            api_token_var="OPENAIAPI_API_KEY"
            ;;
        OpenRouter)
            embeddingprovider="Local"
            api_token_var="OPENROUTER_API_KEY"
            ;;
        Test)
            embeddingprovider="Local"
            api_token_var="TEST_SERVER_IP"
            ;;
        *) help
           return 1
           ;;
    esac
    if [[ -n "${!api_token_var:-}" ]]; then
        api_token="${!api_token_var}"
    else
        if [ ${command} == "start" ]; then
            echo "${api_token_var} is not set"
            return 1
        fi
    fi

    if [[ -n "${memory_transfer_dir}" ]]; then
        if [[ "${memory_transfer_dir}" != /* ]]; then
            echo "--memory-transfer-dir must be an absolute path: ${memory_transfer_dir}" >&2
            return 1
        fi
        if ! mkdir -p "${memory_transfer_dir}"; then
            echo "Could not create --memory-transfer-dir: ${memory_transfer_dir}" >&2
            return 1
        fi
        if [[ ! -w "${memory_transfer_dir}" ]]; then
            echo "--memory-transfer-dir is not writable: ${memory_transfer_dir}" >&2
            return 1
        fi
    fi

    if [[ -n "${memory_import_file}" ]]; then
        if [[ ! "${memory_import_file}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.tar\.gz$ ]]; then
            echo "--memory-import must be a plain filename, not a path: ${memory_import_file}" >&2
            return 1
        fi
        if [[ -z "${memory_transfer_dir}" ]]; then
            echo "--memory-import requires --memory-transfer-dir to be set" >&2
            return 1
        fi
        if [[ ! -f "${memory_transfer_dir}/${memory_import_file}" ]]; then
            echo "--memory-import archive not found: ${memory_transfer_dir}/${memory_import_file}" >&2
            return 1
        fi
    fi

    if [[ "${memory_export_enabled}" == "1" && -z "${memory_transfer_dir}" ]]; then
        echo "--enable-memory-export requires --memory-transfer-dir" >&2
        return 1
    fi

    if [[ "${memory_import_only_history}" == "1" && "${memory_import_only_vector}" == "1" ]]; then
        echo "--only-history and --only-vector cannot be combined" >&2
        return 1
    fi
    if [[ -z "${memory_import_file}" &&
          ( "${memory_import_only_history}" == "1" ||
            "${memory_import_only_vector}" == "1" ) ]]; then
        echo "Import component flags require --memory-import" >&2
        return 1
    fi

    if [[ "${memory_import_mode}" != "overwrite" && "${memory_import_mode}" != "append" ]]; then
        echo "--memory-mode must be overwrite or append" >&2
        return 1
    fi
}

start() {
    docker pull "${image}" 2>/dev/null || true
    ensure_launcher_matches_image || return 1

    container_log_config_path=""
    log_config_volume=()
    memory_transfer_volume=()
    memory_import_env=()
    memory_export_option=()

    if [ -n "${log_config_path}" ]; then
        if [ ! -f "${log_config_path}" ]; then
            echo "Logging config file not found: ${log_config_path}" >&2
            return 1
        fi

        log_config_abs="$(cd -- "$(dirname -- "${log_config_path}")" && pwd)/$(basename -- "${log_config_path}")"
        container_log_config_path="/tmp/omega-logging.conf"
        log_config_volume=(--volume "${log_config_abs}:${container_log_config_path}:ro")
    fi

    if [ -n "${memory_transfer_dir}" ]; then
        memory_transfer_volume=(--volume "${memory_transfer_dir}:/memory-transfer")
        if ! docker run --rm --user 65534:65534 --entrypoint /bin/sh \
            --volume "${memory_transfer_dir}:/memory-transfer" "${image}" \
            -c 'test -d /memory-transfer && test -w /memory-transfer'; then
            echo "--memory-transfer-dir must be writable by container user 65534:65534" >&2
            return 1
        fi
    fi

    if [[ "${memory_export_enabled}" == "1" ]]; then
        memory_export_option=("memoryExportEnabled=true")
    fi

    if [ -n "${memory_import_file}" ]; then
        memory_import_env=(
            -e "MEMORY_IMPORT_FILE=${memory_import_file}"
            -e "MEMORY_IMPORT_MODE=${memory_import_mode}"
        )
        if [[ "${memory_import_only_history}" == "1" ]]; then
            memory_import_env+=(-e MEMORY_IMPORT_NO_VECTOR=1)
        fi
        if [[ "${memory_import_only_vector}" == "1" ]]; then
            memory_import_env+=(-e MEMORY_IMPORT_NO_HISTORY=1)
        fi
    fi

    docker rm -f omega 2>/dev/null || true

    docker_cmd=(
        docker run -d -it
            --name omega
            --security-opt no-new-privileges:true
            --init
            --add-host=host.docker.internal:host-gateway
            --tmpfs /tmp:size=64m,mode=1777
            --tmpfs /var/tmp:size=64m,mode=1777
            --tmpfs /run:size=16m,mode=755
            --volume omega-memory:/PeTTa/repos/Omega/memory
            ${log_config_volume[@]+"${log_config_volume[@]}"}
            ${memory_transfer_volume[@]+"${memory_transfer_volume[@]}"}
            -e "${api_token_var}"="${api_token}"
            -e "TG_BOT_TOKEN=${TG_BOT_TOKEN:-}"
            -e "SL_BOT_TOKEN=${SL_BOT_TOKEN:-}"
            -e "OMEGA_OPENCLAW_TOKEN=${OMEGA_OPENCLAW_TOKEN:-}"
            -e OMEGA_AUTH_SECRET="$OMEGA_AUTH_SECRET"
            -e IMPORT_KB_ON_START="${IMPORT_KB_ON_START:-0}"
            ${memory_import_env[@]+"${memory_import_env[@]}"}
            "$image"
            "commchannel=${commchannel}"
            "provider=${provider}"
            "embeddingprovider=${embeddingprovider}"
            "securityPolicyPath=/PeTTa/repos/Omega/profile/policy.yaml"
            ${memory_export_option[@]+"${memory_export_option[@]}"}
    )

    if [ -n "${container_log_config_path}" ]; then
        docker_cmd+=("logConfigPath=${container_log_config_path}")
    fi

    if [ "${commchannel}" = "irc" ]; then
      docker_cmd+=("IRC_channel=${IRC_channel}")
    elif [ "${commchannel}" = "telegram" ]; then
      docker_cmd+=("TG_POLL_TIMEOUT=${TG_POLL_TIMEOUT}")
    elif [ "${commchannel}" = "slack" ]; then
      docker_cmd+=("SL_CHANNEL_ID=${SL_CHANNEL_ID}")
      docker_cmd+=("SL_POLL_INTERVAL=${SL_POLL_INTERVAL}")
    elif [ "${commchannel}" = "websocket" ]; then
      docker_cmd+=("WS_URL=${WS_URL}")
      docker_cmd+=("WS_TOKEN=${WS_TOKEN}")
    elif [ "${commchannel}" = "test" ]; then
      docker_cmd+=("TEST_SERVER_IP=${TEST_SERVER_IP}")
    else
      echo "Unsupported commchannel: ${commchannel}" >&2
      return 1
    fi

    if [ -n "${model:-}" ]; then
      docker_cmd+=("model=${model}")
    fi

    if [ -n "${openaiapi_url:-}" ]; then
      docker_cmd+=("openaiapi_url=${openaiapi_url}")
    fi

    if [ -n "${openclaw_url:-}" ]; then
      docker_cmd+=("openclaw_url=${openclaw_url}")
      docker_cmd+=("openClawEnabled=enabled")
      docker_cmd+=("openClawURL=${openclaw_url}")
    fi

    "${docker_cmd[@]}"
}

stop() {
    docker stop omega
}

clean() {
    docker rm -f omega
    docker volume rm omega-memory
}

set -euo pipefail
options "$@"
case "${command}" in
    start) start ;;
    stop) stop ;;
    clean) clean ;;
    --version|-v) version ;;
    -h|--help) help ;;
    *) image="${command}"
       bootstrap
       ;;
esac
